# ============================================================
# academic-search · 环境变量配置模板
# ============================================================
# 使用方法：复制本文件为 .env 并填入你自己的 API Key
#   cp .env.example .env
# 也可改为在系统环境变量中设置（二选一即可）。
#
# ⚠️ .env 含 API Key，已在 .gitignore 中排除，绝不会随 skill 分发。
# ============================================================

# --- Semantic Scholar （强烈推荐，免费）---
# 申请: https://www.semanticscholar.org/product/api#api-key
# 无 key 限频 1次/5秒，有 key 1次/秒，稳定性显著提升
S2_API_KEY=

# --- OpenAlex （推荐，免费 polite pool）---
# 填你的邮箱即可获得 polite pool 更宽松限频（无需付费）
# 付费 API Key 申请: https://openalex.org/pricing （免费版也有 key，发邮件即可）
OA_MAILTO=your.email@example.com
OPENALEX_API_KEY=

# --- LLM 中文摘要 （可选，不配也能生成英文报告）---
# 任何 OpenAI 兼容接口均可，例如：
#   火山引擎豆包: LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek:     LLM_BASE_URL=https://api.deepseek.com/v1
#   通义千问:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:       LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
